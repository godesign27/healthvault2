{
  "name": "@health-vault/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prestart": "node ../../scripts/patch-react-native-css-interop.cjs",
    "start": "bash ../../scripts/expo-with-fd-limit.sh start --dev-client --localhost",
    "start:go": "bash ../../scripts/expo-with-fd-limit.sh start --localhost",
    "start:lan": "bash ../../scripts/expo-with-fd-limit.sh start --dev-client",
    "mobile": "npm run start",
    "mobile:8083": "npm run start -- --port 8083",
    "preandroid": "node ../../scripts/patch-react-native-css-interop.cjs",
    "android": "expo run:android",
    "preios": "node ../../scripts/patch-react-native-css-interop.cjs",
    "ios": "expo run:ios",
    "ios:lan": "bash ../../scripts/expo-with-fd-limit.sh start --ios",
    "mobile:ios": "npm run ios",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@health-vault/api-client": "*",
    "@health-vault/types": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-document-picker": "~12.0.2",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.3.3"
  }
}
